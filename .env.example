VITE_SUPABASE_URL=https://qxhzptgbmkmxhuswshka.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=cole_sua_chave_publicavel_ou_anon_aqui

# Somente no ambiente de servidor Vercel (NUNCA prefixar com VITE_ e NUNCA preencher no Git)
# WHATSAPP_META_VERIFY_TOKEN=defina_um_segredo_aleatorio
# WHATSAPP_META_APP_SECRET=preencha_no_painel_seguro_vercel
# WHATSAPP_META_PHONE_NUMBER_ID=preencha_no_painel_seguro_vercel
# WHATSAPP_CRM_OWNER_ID=uuid_do_proprietario
# SUPABASE_SERVICE_ROLE_KEY=preencha_no_painel_seguro_vercel
# SUPABASE_URL=https://qxhzptgbmkmxhuswshka.supabase.co

# ADM Central — captura de pagamentos confirmados (somente servidor Vercel)
# Configurar em Vercel/Settings/Environment Variables. Nunca usar VITE_.
# Owner UUID do usuário autenticado do CRM que receberá os registros
ADM_OWNER_USER_ID=
# Um segredo aleatório forte e diferente por produto
ADM_PDP_WEBHOOK_SECRET=
ADM_QSE_WEBHOOK_SECRET=
# Necessários no backend para validar e persistir receitas (já listados acima):
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL=
#
# POST /api/revenue-webhook — somente backends dos produtos, APÓS confirmação
# autenticada no provedor de pagamentos; nunca chamar diretamente do navegador.
# Headers: x-adm-project, x-adm-timestamp (Unix segundos),
#          x-adm-signature=sha256=<HMAC-SHA256 do texto timestamp + '.' + corpo bruto>
# JSON: { "event_id":"id-unico-do-pagamento", "status":"paid",
#         "amount_cents":1, "currency":"BRL", "description":"Pagamento confirmado" }
# O ID único impede registros repetidos da mesma transação.
# PENDENTE: conectar o backend de cobrança do Ponto do Pedido e do Quem Sou Eu;
# nenhuma cobrança é capturada automaticamente antes dessa integração.
